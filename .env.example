# Copy this file to .env and paste in your keys. NEVER commit .env.

# --- Generator (Gemini 3.6 Flash) ---
# Google AI Studio, free tier -> https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Judge (RAGAS faithfulness / answer relevancy) ---
# Default provider is DeepInfra. Sign up at https://deepinfra.com (no card
# required; $1 signup credit covers this experiment). Key page: /dash/api_keys
DEEPINFRA_API_KEY=

# --- Alternative judge provider ---
# Only needed if you change config.JUDGE_PROVIDER to "openai".
OPENAI_API_KEY=
